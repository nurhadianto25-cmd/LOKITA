{
  "expo": {
    "name": "LOKITA",
    "slug": "lokita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lokita",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.structuredorders.kmll9t",
      "infoPlist": {
        "NSCameraUsageDescription": "Ambil foto produk dan bukti pengiriman",
        "NSPhotoLibraryUsageDescription": "Pilih foto produk dan bukti dari galeri"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0FA958"
      },
      "package": "com.emergent.structuredorders.kmll9t",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0FA958"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto produk dan bukti dari galeri",
          "cameraPermission": "Ambil foto produk dan bukti pengiriman"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
